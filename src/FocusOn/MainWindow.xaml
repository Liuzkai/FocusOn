<Window x:Class="FocusOn.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FocusOn" Title="FocusOn" Width="1120" Height="760" MinWidth="860" MinHeight="580" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Background="{DynamicResource ReviewBackground}" Foreground="{DynamicResource ReviewText}">
    <Window.Resources>
        <SolidColorBrush x:Key="ReviewBackground" Color="#222222" />
        <SolidColorBrush x:Key="ReviewSurface" Color="#292929" />
        <SolidColorBrush x:Key="ReviewHover" Color="#363636" />
        <SolidColorBrush x:Key="ReviewBorder" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ReviewText" Color="#E5E5E5" />
        <SolidColorBrush x:Key="ReviewMuted" Color="#A0A2A8" />
        <SolidColorBrush x:Key="ReviewAccent" Color="#78A4EF" />
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ReviewSurface}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBack" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Background="{DynamicResource ReviewMuted}">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="2" /></ControlTemplate></Thumb.Template>
                                </Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="PageForward" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="10" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PageBack" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="PageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ReviewMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource ReviewHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource ReviewText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource ReviewAccent}" />
                                <Setter TargetName="ButtonFace" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ReviewText}" />
            <Setter Property="Background" Value="{DynamicResource ReviewSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ReviewBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ReviewAccent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ReviewAccent}" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{DynamicResource ReviewText}" />
            <Setter Property="Background" Value="{DynamicResource ReviewSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ReviewBorder}" />
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource ReviewText}" />
            <Setter Property="Background" Value="{DynamicResource ReviewSurface}" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource ReviewMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowFace" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ReviewBorder}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowFace" Property="Background" Value="{DynamicResource ReviewSurface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowFace" Property="Background" Value="{DynamicResource ReviewHover}" />
                                <Setter TargetName="RowFace" Property="BorderBrush" Value="{DynamicResource ReviewAccent}" />
                                <Setter TargetName="RowFace" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowFace" Property="BorderThickness" Value="1" />
                                <Setter TargetName="RowFace" Property="BorderBrush" Value="{DynamicResource ReviewAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FocusOn" FontWeight="SemiBold" Margin="2,0,16,0" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource ReviewSurface}" BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" Padding="8,5">
                        <Grid>
                            <TextBox x:Name="TimerTitleBox" MaxLength="200" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="计时标题" />
                            <TextBlock Text="写一个标题，开始计时…" IsHitTestVisible="False" Foreground="{DynamicResource ReviewMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TimerTitleBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerElapsedText" FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource ReviewAccent}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="标题计时累计时长" />
                        <Button x:Name="StartTimerButton" Content="开始计时" Click="StartTimer_Click" Background="{DynamicResource ReviewHover}" Foreground="{DynamicResource ReviewText}" />
                        <Button x:Name="PauseTimerButton" Content="暂停" Click="PauseTimer_Click" Visibility="Collapsed" AutomationProperties.Name="暂停或继续标题计时" />
                        <Button x:Name="StopTimerButton" Content="停止" Click="StopTimer_Click" Visibility="Collapsed" AutomationProperties.Name="停止并保存标题计时" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TimerErrorText" Foreground="{DynamicResource ReviewAccent}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="正在读取" Foreground="{DynamicResource ReviewMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="PauseButton" Content="暂停记录" Click="PauseButton_Click" AutomationProperties.Name="暂停或继续记录" />
                    <Button x:Name="DeleteDayButton" Content="删除当天…" Click="DeleteDay_Click" AutomationProperties.Name="确认删除所选日期的记录" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousDayButton" Content="‹" Click="PreviousDay_Click" AutomationProperties.Name="上一天" />
                    <DatePicker x:Name="ViewDatePicker" Width="128" FontSize="12" VerticalAlignment="Center" SelectedDateChanged="ViewDatePicker_SelectedDateChanged" AutomationProperties.Name="回看日期" />
                    <Button x:Name="NextDayButton" Content="›" Click="NextDay_Click" AutomationProperties.Name="下一天" />
                    <Button x:Name="TodayButton" Content="今天" Click="Today_Click" />
                    <TextBlock x:Name="DateText" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
            </StackPanel>
        </Border>
        <Border x:Name="WarningPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ReviewSurface}" BorderBrush="{DynamicResource ReviewAccent}" BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DurationButton" Content="◷  时长" Background="{DynamicResource ReviewHover}" Foreground="{DynamicResource ReviewText}" Click="Duration_Click" AutomationProperties.Name="显示或隐藏时长时间线" />
                    <Button x:Name="GroupsButton" Content="时段  ⊟" Click="Groups_Click" AutomationProperties.Name="显示或隐藏时段分隔" />
                    <Button x:Name="DetailsButton" Content="详情  ⊞" Click="Details_Click" AutomationProperties.Name="显示或隐藏记录详情" />
                    <Button x:Name="RecordedModeButton" Content="记录范围" Click="RecordedMode_Click" AutomationProperties.Name="时间轴显示当天记录范围并自动增长" />
                    <Button x:Name="FullDayModeButton" Content="24h" Click="FullDayMode_Click" AutomationProperties.Name="时间轴显示本地全天" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="5" BorderBrush="{DynamicResource ReviewMuted}" BorderThickness="0.5" Background="{DynamicResource ReviewSurface}" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" Foreground="{DynamicResource ReviewMuted}" FontSize="16" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0" TextChanged="Search_TextChanged" AutomationProperties.Name="搜索当天软件或窗口标题" />
                        <TextBlock Grid.Column="1" Text="搜索" IsHitTestVisible="False" Foreground="{DynamicResource ReviewMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <StackPanel x:Name="TimelinePanel" Grid.Row="3" Background="{DynamicResource ReviewSurface}">
            <local:TimelineControl x:Name="TimelineView" />
            <DockPanel Margin="8,1,8,5">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ZoomInButton" Content="＋" Click="ZoomIn_Click" Padding="6,1" AutomationProperties.Name="放大时间线" />
                    <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" Padding="6,1" AutomationProperties.Name="缩小时间线" />
                    <Button x:Name="ResetDayButton" Content="重置视图" Click="ResetDay_Click" Padding="6,1" />
                    <Button x:Name="ClearRangeButton" Content="取消范围" Click="ClearRange_Click" Padding="6,1" />
                </StackPanel>
                <TextBlock x:Name="ViewRangeText" FontSize="11" Foreground="{DynamicResource ReviewMuted}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
        <Border Grid.Row="4" BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="0,1,0,1" Padding="12,7">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="全天" DockPanel.Dock="Left" Foreground="{DynamicResource ReviewMuted}" Margin="0,0,14,0" />
                    <ScrollViewer MaxHeight="46" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="TotalsList" AutomationProperties.Name="全天软件时长汇总">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,2">
                                        <Rectangle Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AppName}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource ReviewMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <TextBlock x:Name="TotalsEmptyText" Text="正在读取…" Foreground="{DynamicResource ReviewMuted}" />
                <TextBlock x:Name="RangeText" FontSize="11" Foreground="{DynamicResource ReviewMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LogGrid" SelectionMode="Single" SelectionChanged="LogGrid_SelectionChanged" Background="Transparent" Foreground="{DynamicResource ReviewText}" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="按时间顺序排列的使用日志">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Background="{DynamicResource ReviewSurface}" Padding="8,2" BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GroupLabel}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding GroupLabel}" FontSize="11" Foreground="{DynamicResource ReviewMuted}" />
                            </Border>
                            <Grid Height="42" Margin="8,0,12,0" ToolTip="{Binding StartFull}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StartTime}" FontSize="11" Foreground="{DynamicResource ReviewMuted}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="6,3" HorizontalAlignment="Right" Margin="0,0,12,0" MaxWidth="118" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeLabel}" Foreground="{Binding Color}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Application}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{DynamicResource ReviewMuted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="LogEmptyText" Text="正在读取…" Foreground="{DynamicResource ReviewMuted}" Margin="20,24" VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False" />
            <Border x:Name="InspectorPane" Grid.Column="1" Visibility="Collapsed" Padding="16" Background="{DynamicResource ReviewSurface}" BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="×" Click="Details_Click" DockPanel.Dock="Right" AutomationProperties.Name="关闭记录详情" />
                            <TextBlock Text="记录详情" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="DetailsEmptyText" Text="选择一条记录，查看完整标题与时间。" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Application}" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource ReviewMuted}" Margin="0,5,0,0" />
                            <TextBlock x:Name="WindowTitleLabel" Text="窗口标题 / 原因" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding Title, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.LabeledBy="{Binding ElementName=WindowTitleLabel}" />
                            <TextBlock Text="开始" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding StartFull}" TextWrapping="Wrap" />
                            <TextBlock Text="结束 / 实时显示终点" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EndFull}" TextWrapping="Wrap" />
                            <TextBlock Text="持续时长" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding PreciseDuration}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentNote}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="6" Padding="12,6" BorderBrush="{DynamicResource ReviewBorder}" BorderThickness="0,1,0,0">
            <TextBlock FontSize="11" Foreground="{DynamicResource ReviewMuted}" Text="使用仅记录激活窗口 · 停止为灰色，未记录为使用行斜纹，计时为蓝色 · 实时尾段可能尚未保存" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
