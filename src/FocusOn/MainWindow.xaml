<Window x:Class="FocusOn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusOn"
        Title="FocusOn" Width="1120" Height="760" MinWidth="860" MinHeight="580"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style x:Key="LogCellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,7" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="前台使用回看" FontSize="22" FontWeight="SemiBold" />
                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                    <Button x:Name="PreviousDayButton" Content="上一天" Click="PreviousDay_Click" />
                    <DatePicker x:Name="ViewDatePicker" Width="150" Margin="6,0" VerticalAlignment="Center"
                                SelectedDateChanged="ViewDatePicker_SelectedDateChanged" AutomationProperties.Name="回看日期" />
                    <Button x:Name="NextDayButton" Content="下一天" Click="NextDay_Click" />
                    <Button x:Name="TodayButton" Content="今天" Click="Today_Click" />
                    <Button x:Name="DeleteDayButton" Content="删除该日…" Click="DeleteDay_Click" AutomationProperties.Name="确认删除所选日期的记录" />
                </WrapPanel>
                <TextBlock x:Name="DateText" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock x:Name="StatusText" Text="正在读取当前记录状态" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                <Button x:Name="PauseButton" Content="暂停" Click="PauseButton_Click" AutomationProperties.Name="暂停或继续记录" />
            </StackPanel>
        </Grid>
        <Border x:Name="WarningPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1" Padding="12" Margin="0,0,0,16">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
        </Border>
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="当天软件时长" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="TotalsList" AutomationProperties.Name="全天软件时长汇总">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <Rectangle Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Duration}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="TotalsEmptyText" Text="正在读取…" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,6">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="ZoomInButton" Content="放大" Click="ZoomIn_Click" />
                    <Button x:Name="ZoomOutButton" Content="缩小" Click="ZoomOut_Click" />
                    <Button x:Name="ResetDayButton" Content="恢复全天" Click="ResetDay_Click" />
                    <Button x:Name="ClearRangeButton" Content="取消范围" Click="ClearRange_Click" />
                </WrapPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="使用时间线" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ViewRangeText" FontSize="12" />
                </StackPanel>
            </DockPanel>
            <local:TimelineControl x:Name="TimelineView" />
            <TextBlock Text="灰色：停止计时（原因见区段/日志） · 斜纹：未记录 · 空白：没有可用记录" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="RangeText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="时间顺序日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid x:Name="LogGrid" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" SelectionChanged="LogGrid_SelectionChanged"
                          Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                          Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                          AutomationProperties.Name="使用记录日志">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="起止时间" Binding="{Binding TimeRange}" Width="165" ElementStyle="{StaticResource LogCellText}" />
                        <DataGridTextColumn Header="软件 / 状态" Binding="{Binding Application}" Width="130" ElementStyle="{StaticResource LogCellText}" />
                        <DataGridTextColumn Header="窗口标题" Binding="{Binding Title}" Width="*" MinWidth="60" ElementStyle="{StaticResource LogCellText}" />
                        <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="120" ElementStyle="{StaticResource LogCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="LogEmptyText" Grid.Row="1" Text="正在读取…" Margin="16,55,16,0"
                           VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False" />
            </Grid>
            <Border Grid.Column="2" Padding="16" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="记录详情" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailsEmptyText" Text="选择一条记录，查看完整标题与时间。"
                                   Margin="0,16,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Application}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Kind}" Margin="0,5,0,0" />
                            <TextBlock x:Name="WindowTitleLabel" Text="窗口标题 / 原因" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding Title, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=WindowTitleLabel}" />
                            <TextBlock Text="开始" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding StartFull}" TextWrapping="Wrap" />
                            <TextBlock Text="结束 / 实时显示终点" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EndFull}" TextWrapping="Wrap" />
                            <TextBlock Text="持续时长" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding PreciseDuration}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentNote}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="前台使用时长不代表实际注意力。进行中的尾段可能尚未保存。" />
    </Grid>
</Window>
