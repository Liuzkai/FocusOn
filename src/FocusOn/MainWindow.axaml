<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FocusOn"
        x:Class="FocusOn.MainWindow" Title="FocusOn" Width="1100" Height="720" MinWidth="740" MinHeight="500"
        Background="{DynamicResource ReviewBackground}" Foreground="{DynamicResource ReviewText}">
  <Window.Styles>
    <Style Selector="Border.settings-card"><Setter Property="Background" Value="{DynamicResource ReviewSurface}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /></Style>
    <Style Selector="TextBlock.settings-heading"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="14">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="FocusOn" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
      <Button x:Name="ReviewPageButton" Grid.Column="1" Content="回看" />
      <Button x:Name="StatisticsPageButton" Grid.Column="2" Content="统计" />
      <Button x:Name="SettingsPageButton" Grid.Column="3" Content="配置" />
      <Button x:Name="PauseButton" Grid.Column="5" Content="暂停记录" />
      <Button x:Name="ExitButton" Grid.Column="6" Content="退出" />

    </Grid>
    <Grid x:Name="ReviewPane" Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="6">
      <Button x:Name="PreviousDayButton" Content="‹" AutomationProperties.Name="前一天" />
      <CalendarDatePicker SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" x:Name="ViewDatePicker" Grid.Column="1" Width="150" AutomationProperties.Name="回看日期" />
      <Button x:Name="NextDayButton" Grid.Column="2" Content="›" AutomationProperties.Name="后一天" />
      <Button x:Name="TodayButton" Grid.Column="3" Content="今天" />
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0">
        <TextBlock x:Name="DateText" />
        <TextBlock x:Name="StatusText" Text="正在启动…" Foreground="{DynamicResource ReviewAccent}" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="0" Spacing="5">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBox x:Name="TimerTitleBox" Watermark="输入标题，开始独立计时" MaxLength="200" AutomationProperties.Name="计时标题" />
        <TextBlock x:Name="TimerElapsedText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource ReviewAccent}" />
        <Button x:Name="StartTimerButton" Grid.Column="2" Content="开始计时" />
        <Button x:Name="PauseTimerButton" Grid.Column="3" Content="暂停" IsVisible="False" />
        <Button x:Name="StopTimerButton" Grid.Column="4" Content="停止" IsVisible="False" />

      </Grid>
      <TextBlock x:Name="TimerErrorText" Foreground="{DynamicResource ReviewWarningText}" TextWrapping="Wrap" />
      <TextBlock x:Name="ResidencyText" Foreground="{DynamicResource ReviewMuted}" TextWrapping="Wrap" IsVisible="False" />
      <Border x:Name="WarningPanel" Background="{DynamicResource ReviewWarningBackground}" Padding="10" CornerRadius="5" IsVisible="False">
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{DynamicResource ReviewWarningText}" />
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock x:Name="TotalsHeading" Text="全天软件汇总" FontWeight="SemiBold" />
      <local:AppTotalsScrollViewer x:Name="TotalsScrollViewer" AllowAutoHide="False" AutomationProperties.Name="全天软件汇总">
        <ItemsControl x:Name="TotalsList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="10,6" Background="{DynamicResource ReviewBadge}" CornerRadius="5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding AppName}" Foreground="{Binding Color}" />
                  <TextBlock Text="{Binding Duration}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </local:AppTotalsScrollViewer>
      <TextBlock x:Name="TotalsEmptyText" Foreground="{DynamicResource ReviewMuted}" />
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="6">
      <WrapPanel>
        <Button x:Name="DurationButton" Content="时长" Margin="0,0,6,4" />
        <Button x:Name="GroupsButton" Content="时段 ⊟" Margin="0,0,6,4" />
        <Button x:Name="DetailsButton" Content="详情 ⊞" Margin="0,0,6,4" />
        <ComboBox x:Name="RangePicker" Width="105" SelectedIndex="0" Margin="0,0,6,4" AutomationProperties.Name="时间范围">
          <ComboBoxItem Content="1h" Tag="1" /><ComboBoxItem Content="2h" Tag="2" />
          <ComboBoxItem Content="4h" Tag="4" /><ComboBoxItem Content="6h" Tag="6" />
          <ComboBoxItem Content="8h" Tag="8" /><ComboBoxItem Content="12h" Tag="12" />
          <ComboBoxItem Content="24h" Tag="24" /><ComboBoxItem x:Name="TodayRangeItem" Content="今天" Tag="today" />
        </ComboBox>
        <Button x:Name="ZoomInButton" Content="＋" Margin="0,0,6,4" AutomationProperties.Name="放大时间线" />
        <Button x:Name="ZoomOutButton" Content="－" Margin="0,0,6,4" AutomationProperties.Name="缩小时间线" />
        <Button x:Name="ResetDayButton" Content="重置" Margin="0,0,6,4" />
        <Button x:Name="ClearRangeButton" Content="清除范围" Margin="0,0,6,4" />
        <Button x:Name="DeleteDayButton" Content="删除所选日期" Margin="0,0,6,4" />
      </WrapPanel>
      <TextBox x:Name="SearchBox" Watermark="搜索时间范围内的软件或窗口标题" AutomationProperties.Name="搜索时间范围内的软件或窗口标题" />
      <local:TimelineControl x:Name="TimelineView" />
      <TextBlock x:Name="RangeText" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" FontSize="12" />
    </StackPanel>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Grid>
        <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="48" Background="{DynamicResource ReviewSurface}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="开始时间" Width="125">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding GroupLabel}" FontSize="10" Foreground="{DynamicResource ReviewMuted}" /><TextBlock Text="{Binding StartTime}" /></StackPanel></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="软件 / 状态" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding BadgeBackground}" Padding="7,4" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Application}" Foreground="{Binding Color}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="窗口标题 / 说明" Binding="{Binding Title}" Width="*" />
            <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="LogEmptyText" Text="正在读取记录…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ReviewMuted}" IsHitTestVisible="False" />
      </Grid>
      <Border x:Name="InspectorPane" Grid.Column="1" Width="265" Padding="12" Background="{DynamicResource ReviewSurface}" CornerRadius="5" IsVisible="False">
        <ScrollViewer><StackPanel Spacing="8">
          <TextBlock x:Name="DetailsHeading" Text="记录详情" FontWeight="SemiBold" />
          <TextBlock x:Name="DetailsEmptyText" Text="选择一条记录查看详情。" Foreground="{DynamicResource ReviewMuted}" />
          <StackPanel x:Name="DetailsPanel" IsVisible="False" Spacing="8">
            <TextBlock Text="{Binding Application}" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource ReviewMuted}" />
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StartFull}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EndFull}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PreciseDuration}" />
            <TextBlock Text="{Binding CurrentNote}" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
          </StackPanel>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    </Grid>
    <local:StatisticsPage x:Name="StatisticsView" Grid.Row="1" IsVisible="False" />
    <ScrollViewer x:Name="SettingsPane" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch" Margin="0,0,12,18">
        <TextBlock x:Name="SettingsHeading" Text="配置" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="SettingsError" Foreground="{DynamicResource ReviewWarningText}" TextWrapping="Wrap" IsVisible="False" />
        <Border Classes="settings-card"><StackPanel Spacing="12">
          <TextBlock x:Name="AppearanceHeading" Classes="settings-heading" Text="外观" />
          <WrapPanel>
            <StackPanel Spacing="5" Margin="0,0,28,8"><TextBlock x:Name="LanguageLabel" Text="界面语言" Foreground="{DynamicResource ReviewMuted}" />
              <ComboBox x:Name="LanguagePicker" MinWidth="170"><ComboBoxItem Content="中文" Tag="zh-CN" /><ComboBoxItem Content="English" Tag="en" /></ComboBox>
            </StackPanel>
            <StackPanel Spacing="5" Margin="0,0,0,8"><TextBlock x:Name="ThemeLabel" Text="主题" Foreground="{DynamicResource ReviewMuted}" />
              <ComboBox x:Name="ThemePicker" MinWidth="170"><ComboBoxItem Content="Dark" Tag="dark" /><ComboBoxItem Content="Light" Tag="light" /></ComboBox>
            </StackPanel>
          </WrapPanel>
          <TextBlock x:Name="AppearanceNote" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
        </StackPanel></Border>
        <Border Classes="settings-card"><StackPanel Spacing="10">
          <TextBlock x:Name="BehaviorHeading" Classes="settings-heading" Text="启动与后台运行" />
          <CheckBox x:Name="StartupCheckBox" Content="登录时启动到托盘" />
          <TextBlock x:Name="BehaviorNote" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
        </StackPanel></Border>
        <Border Classes="settings-card"><StackPanel Spacing="10">
          <TextBlock x:Name="StorageHeading" Classes="settings-heading" Text="数据保存" />
          <TextBlock x:Name="StorageNote" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
          <TextBlock x:Name="CurrentDataDirectoryText" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
          <TextBox x:Name="DataDirectoryBox" />
          <WrapPanel><Button x:Name="OpenDataButton" Content="打开数据目录" Margin="0,0,8,6" /><Button x:Name="BrowseDataButton" Content="选择目录…" Margin="0,0,8,6" /><Button x:Name="ChangeDataButton" Content="保存并重启" Margin="0,0,8,6" /></WrapPanel>
        </StackPanel></Border>
        <Border Classes="settings-card"><StackPanel Spacing="10">
          <TextBlock x:Name="UpdatesHeading" Classes="settings-heading" Text="更新" />
          <TextBlock x:Name="UpdateNote" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
          <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
          <WrapPanel><Button x:Name="CheckUpdatesButton" Content="检查更新" Margin="0,0,8,6" /><Button x:Name="DownloadUpdateButton" Content="下载并安装…" Margin="0,0,8,6" IsVisible="False" /><Button x:Name="ReleasePageButton" Content="查看 Release" Margin="0,0,8,6" /></WrapPanel>
        </StackPanel></Border>
        <Border Classes="settings-card"><StackPanel Spacing="10">
          <TextBlock x:Name="AboutHeading" Classes="settings-heading" Text="关于" />
          <TextBlock x:Name="VersionText" />
          <Button x:Name="GithubButton" Content="github.com/Liuzkai/FocusOn ↗" HorizontalAlignment="Left" />
          <TextBlock x:Name="AboutNote" TextWrapping="Wrap" Foreground="{DynamicResource ReviewMuted}" />
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
